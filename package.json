{
  "name": "surge",
  "private": true,
  "type": "module",
  "description": "Flash-sale ticket booking platform built to survive traffic spikes",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "typecheck": "tsc -p tsconfig.check.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "migrate": "node-pg-migrate --migrations-dir db/migrations --migration-file-language sql",
    "dev:booking": "pnpm --filter @surge/booking-api dev"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/testing": "^12.1.1",
    "@testcontainers/postgresql": "~12.1.0",
    "@testcontainers/redis": "~12.1.0",
    "@testcontainers/redpanda": "~12.1.0",
    "@types/node": "^24.19.0",
    "eslint": "^10.11.0",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.9",
    "testcontainers": "~12.1.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "~8.70.1",
    "vitest": "~4.1.11"
  }
}
