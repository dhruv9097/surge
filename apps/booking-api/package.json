{
  "name": "@surge/booking-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "start": "node --enable-source-maps --import ./dist/instrument.js dist/main.js",
    "dev": "tsc -b -w --preserveWatchOutput & node --watch --env-file-if-exists=../../.env --enable-source-maps --import ./dist/instrument.js dist/main.js"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.1",
    "@nestjs/core": "^12.1.1",
    "@nestjs/platform-fastify": "^12.1.1",
    "@surge/common": "workspace:*",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  }
}
