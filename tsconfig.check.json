{
  // Type-checks sources *and* tests in one pass (no emit). Used by ESLint and
  // `pnpm typecheck`; the per-package tsconfigs only build shippable code.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "incremental": false,
    "declaration": false,
    "declarationMap": false,
    "types": ["node", "vitest/globals"],
    "paths": {
      "@surge/common": ["./libs/common/src/index.ts"],
      "@surge/common/telemetry": ["./libs/common/src/telemetry/index.ts"]
    }
  },
  "include": ["apps/*/src", "libs/*/src", "vitest.config.ts"]
}
