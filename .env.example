# Copy to .env and change every secret before deploying anywhere.
POSTGRES_USER=surge
POSTGRES_PASSWORD=change-me
POSTGRES_DB=surge

LOG_LEVEL=info
HTTP_PORT=8080

# Resource sizing. Defaults fit a laptop with 8 GB RAM (Docker Desktop at ~5 GB).
# On the cloud VM (24 GB) use the commented values.
BOOKING_API_REPLICAS=1        # VM: 4
BOOKING_API_MEMORY=384M       # VM: 512M
BOOKING_API_HEAP_MB=256       # VM: 384
PG_SHARED_BUFFERS=128MB       # VM: 2GB
PG_EFFECTIVE_CACHE_SIZE=384MB # VM: 6GB
REDIS_MAXMEMORY=256mb         # VM: 1gb
REDPANDA_MEMORY=512M          # VM: 2G

# Tracing (enabled once the observability stack is up)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4318
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1
